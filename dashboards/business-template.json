        {
          "dataset": "tunnel",
          "datasource": {
            "type": "mysql",
            "uid": "{{MYSQL_UID}}"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\n  um.ip AS user_machine_ip,\n  c.bandwidth * 1000000 AS purchased_bandwidth\nFROM configs c\nJOIN machines um\n  ON c.user_machine_code = um.machine_code\n AND um.deleted_at IS NULL\nJOIN bandwidth_lines bl\n  ON c.bandwidth_line_code = bl.bandwidth_line_code\n AND bl.deleted_at IS NULL\n AND bl.is_active = 1\nWHERE c.deleted_at IS NULL\n  AND um.ip IS NOT NULL\n  AND um.ip REGEXP '${user_machines:pipe}'\n  AND c.bandwidth_line_code REGEXP '${bandwidth_line:pipe}'\nORDER BY um.ip;",
          "refId": "B",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
