      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "{{PROMETHEUS_UID}}"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "pop_traffic_tx_rate{user_machine_ip=~\"$user_machines\", pop_instance=~\"$pop_machines\", direction=\"upload\"}",
          "format": "table",
